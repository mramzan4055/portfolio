# Application Environment Variables

# Base URL — use https://mramzan.dev in production
NEXT_PUBLIC_SITE_URL=https://mramzan.dev

# Wasmer Database Configuration (MySQL)
DB_HOST=db.us-losa1.bengt.wasmernet.com
DB_PORT=16751
DB_NAME=db_5322d8a7
DB_USER=user_76e4995e
DB_PASSWORD=your_db_password
DB_SSL=true

# Admin Security — required. Generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SECRET_KEY=

# Analytics (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# SMTP Email Configuration (Optional — for contact form email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
CONTACT_EMAIL=your@gmail.com

# AI Features (Google Gemini or OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=
